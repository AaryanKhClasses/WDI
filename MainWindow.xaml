<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WDI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WDI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:widgetc="using:WDI.Widgets.Clock"
    xmlns:widgetm="using:WDI.Widgets.Media"
    mc:Ignorable="d">

    <Grid>
        <Border
            x:Name="IslandBackground" Background="#181818"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
        >
            <Grid>
                <Grid
                    x:Name="CollapsedContent"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                >
                    <TextBlock
                        x:Name="IslandText" Text="WDI"
                        FontSize="14" FontWeight="Bold" Foreground="White"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        TextAlignment="Center" RenderTransformOrigin="0.5,0.5"
                    />
                    <widgetm:CompactMediaView
                        x:Name="CompactMediaView" Visibility="Collapsed"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    />
                </Grid>
                <Grid
                    x:Name="ExpandedContent" Visibility="Collapsed"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                >
                    <widgetc:ExpandedClockView x:Name="ExpandedClockView" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
