<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WDI.Widgets.Media.CompactMediaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WDI.Widgets.Media"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="14,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button
            x:Name="PreviousButton" Grid.Column="0" Content="⏮️"
            Width="32" Height="32" Padding="0" VerticalAlignment="Center"
        />

        <StackPanel Grid.Column="1" Spacing="1"
            VerticalAlignment="Center" Margin="10,0"
        >
            <TextBlock
                x:Name="TitleText" FontSize="14"
                Foreground="White" Text="No Media" TextTrimming="CharacterEllipsis"
            />
            <TextBlock
                x:Name="ArtistText" FontSize="11"
                Foreground="#999999" Text="Unknown Artist"
            />
        </StackPanel>

        <StackPanel Grid.Column="2" Spacing="4"
            Orientation="Horizontal" VerticalAlignment="Center"
        >
            <Button
                x:Name="PlayPauseButton" Content="▶️"
                Width="34" Height="34" Padding="0"
            />
            <Button
                x:Name="NextButton" Content="⏭️"
                Width="32" Height="32" Padding="0"
            />
        </StackPanel>
    </Grid>
</UserControl>
